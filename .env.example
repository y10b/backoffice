# 이 파일은 템플릿이라 저장소에 커밋됩니다. 실제 키는 여기 쓰지 말고
# .env.local (gitignore 됨) 이나 백오피스 "설정" 화면에 넣으세요.
# 설정 화면에 넣으면 DB 에 저장돼 재시작 없이 바꿀 수 있고, .env.local 값은 폴백입니다.

# --- 네이버 검색광고 API (키워드도구) ---------------------------------
# searchad.naver.com > 도구 > API 사용 관리 에서 발급
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
# 키워드 수집·자동 작성의 시드는 환경변수가 아니라 설정 화면(seeds_naver · seeds_tistory, 쉼표 구분)에 넣습니다. 비우면 src/lib/seeds.ts 기본값.

# --- 네이버 개발자센터 (검색 API + 데이터랩) --------------------------
# developers.naver.com 애플리케이션 등록 시 "검색"과 "데이터랩(검색어트렌드)" 를 모두 체크
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 카카오 로컬 API (방문 후기 장소 보강) ----------------------------
# developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키 (JavaScript 키 아님)
# 네이버 지역검색은 "검색" 스코프 신규 발급이 막혀 쓸 수 없어 카카오로 대체했습니다.
KAKAO_REST_API_KEY=

# --- GA4 (블로그 조회수) ------------------------------------------------
# GCP 서비스 계정 JSON 을 한 줄로 넣거나, 설정 화면에 통째로 붙여넣으세요.
# 속성 ID 는 측정 ID(G-XXXX)가 아니라 관리 > 속성 설정의 숫자입니다.
GA4_SERVICE_ACCOUNT=
GA4_PROPERTY_ID=

# --- 애드센스 (수익) ----------------------------------------------------
# GCP > 사용자 인증 정보 > OAuth 클라이언트 ID (웹 애플리케이션)
# 승인된 리디렉션 URI 에 http://localhost:3939/api/oauth/callback 을 등록해야 합니다.
ADSENSE_CLIENT_ID=
ADSENSE_CLIENT_SECRET=

# --- 저장소 (Supabase Postgres) ----------------------------------------
# 로컬 SQLite 를 대체합니다. Vercel 은 파일시스템이 읽기 전용이라 필수입니다.
# Supabase 대시보드 > Project Settings > API 에서 확인합니다.
# SERVICE_ROLE 키는 RLS 를 우회하므로 서버에서만 쓰고 절대 노출하지 마세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 접근 제어 ----------------------------------------------------------
# 비워두면 인증이 꺼집니다(로컬 편의). 배포 환경에는 반드시 넣으세요 —
# 없으면 URL 을 아는 누구나 API 키와 수익 데이터를 볼 수 있습니다.
BACKOFFICE_PASSWORD=
# 세션 쿠키 서명 키. 비우면 비밀번호로 대신하지만, 따로 두는 편이 안전합니다.
SESSION_SECRET=
# 배포 주소 (예: https://xxx.vercel.app). OAuth 리디렉션 URI 조립에 씁니다.
# 비우면 http://localhost:3939 로 떨어집니다. 바꾸면 GCP 콘솔에도 같은 값을 등록하세요.
APP_ORIGIN=

# --- Gemini (본문 생성) --------------------------------
# https://aistudio.google.com/apikey
# 쉼표·줄바꿈·공백으로 여러 개 넣으면 쿼터에 걸린 키를 건너뜁니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- 개발 로그 (GitHub → velog) ----------------------------------------
# GitHub PAT(classic, repo 스코프)는 비공개 레포 커밋을 읽는 데 씁니다.
# velog 는 공식 쓰기 API 가 없어 로그인 쿠키(access_token)로 올립니다. 만료되면 다시 넣으세요.
# 설정 화면에 넣는 편이 낫습니다 — 아래는 폴백입니다.
GH_PAT=
GH_USER=y10b
# velog 핸들이 GitHub 과 다르면 넣는다. 비우면 GH_USER 를 쓴다.
VELOG_USER=
VELOG_TOKEN=
# refresh_token(30일). access 가 24시간마다 죽어도 이게 있으면 새 토큰을 받아 설정에 저장합니다.
VELOG_REFRESH_TOKEN=
# 절대 수집하지 않을 조직·사용자 (쉼표 구분). 회사 코드가 공개 블로그로 새는 걸 막습니다.
DEVLOG_BLOCKED_OWNERS=bambitcorporation

# --- 자동화 (GitHub Actions) ------------------------------------------
# 러너가 배포본의 /api/cron/* 을 부를 때 쓰는 비밀. 레포 시크릿에도 같은 값을 넣으세요.
CRON_SECRET=

# --- 마이그레이션 적용 (scripts/migrate.mjs) ---------------------------
# supabase.com → Account → Access Tokens 에서 발급. 계정 전체 권한이라 여기(.env.local)에만 둔다.
# PROJECT_REF 는 대시보드 주소 /project/<ref> 의 문자열. SUPABASE_URL 이 있으면 거기서 뽑는다.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
